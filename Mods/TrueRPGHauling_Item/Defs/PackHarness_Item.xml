<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <ThingDef ParentName="ResourceBase">
    <defName>BM_PackHarness</defName>
    <label>pack harness</label>
    <description>Saddlebags and straps for a mount. A mount wearing it carries goods for its assigned rider: when the rider hauls while mounted, the bags are filled first. Animals that are not pack animals can carry loads once harnessed.</description>
    <graphicData>
      <texPath>Things/Pawn/Animal/Muffalo/MuffaloPack</texPath>
      <graphicClass>Graphic_Multi</graphicClass>
      <drawSize>(1.3,1.3)</drawSize>
    </graphicData>
    <stackLimit>1</stackLimit>
    <tradeNeverStack>true</tradeNeverStack>
    <useHitPoints>true</useHitPoints>
    <healthAffectsPrice>true</healthAffectsPrice>
    <resourceReadoutPriority>Middle</resourceReadoutPriority>
    <techLevel>Neolithic</techLevel>
    <thingCategories>
      <li>Manufactured</li>
    </thingCategories>
    <stuffCategories>
      <li>Leathery</li>
      <li>Fabric</li>
    </stuffCategories>
    <costStuffCount>50</costStuffCount>
    <statBases>
      <MaxHitPoints>100</MaxHitPoints>
      <Mass>3</Mass>
      <WorkToMake>2500</WorkToMake>
      <Flammability>1</Flammability>
    </statBases>
    <recipeMaker>
      <workSpeedStat>GeneralLaborSpeed</workSpeedStat>
      <workSkill>Crafting</workSkill>
      <effectWorking>Tailor</effectWorking>
      <soundWorking>Recipe_Tailor</soundWorking>
      <recipeUsers>
        <li>CraftingSpot</li>
        <li>HandTailoringBench</li>
        <li>ElectricTailoringBench</li>
      </recipeUsers>
      <skillRequirements>
        <Crafting>3</Crafting>
      </skillRequirements>
    </recipeMaker>
  </ThingDef>
</Defs>
