<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <ThingDef ParentName="BuildingBase">
    <defName>BM_HitchingPost</defName>
    <label>hitching post</label>
    <description>A post for tying up mounts. When a rider with an assigned mount dismounts to enter a building, the mount walks to the nearest free post and stays there until the rider returns. Up to four mounts fit on one post. Also works as a caravan hitching spot.</description>
    <drawerType>MapMeshAndRealTime</drawerType>
    <graphicData>
      <texPath>Things/Building/Misc/CaravanHitchingSpot</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(1,1)</drawSize>
    </graphicData>
    <altitudeLayer>Building</altitudeLayer>
    <passability>PassThroughOnly</passability>
    <fillPercent>0.15</fillPercent>
    <pathCost>30</pathCost>
    <statBases>
      <WorkToBuild>400</WorkToBuild>
      <MaxHitPoints>80</MaxHitPoints>
      <Flammability>1</Flammability>
    </statBases>
    <costList>
      <WoodLog>15</WoodLog>
    </costList>
    <scatterableOnMapGen>false</scatterableOnMapGen>
    <designationCategory>Misc</designationCategory>
    <uiOrder>2011</uiOrder>
    <building>
      <ai_chillDestination>false</ai_chillDestination>
      <wakeDormantPawnsOnConstruction>false</wakeDormantPawnsOnConstruction>
      <artificialForMeditationPurposes>false</artificialForMeditationPurposes>
    </building>
    <comps>
      <li Class="CompProperties_HitchingSpot"/>
    </comps>
  </ThingDef>

  <JobDef>
    <defName>BM_GoToHitchingPost</defName>
    <driverClass>BondedMounts.JobDriver_GoToHitchingPost</driverClass>
    <reportString>going to the hitching post.</reportString>
    <casualInterruptible>false</casualInterruptible>
  </JobDef>

  <JobDef>
    <defName>BM_FeedMount</defName>
    <driverClass>BondedMounts.JobDriver_FeedMount</driverClass>
    <reportString>feeding TargetB.</reportString>
  </JobDef>
</Defs>
